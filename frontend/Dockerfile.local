# Use Node.js 22 Alpine for a lightweight dev image
FROM node:22-alpine AS develop

WORKDIR /app

# Enable corepack to use pnpm without a separate install step
RUN corepack enable && corepack prepare pnpm@10.10.0 --activate

# Copy only dependency files first (layer cache: rebuilds only when these change)
COPY package.json pnpm-lock.yaml .npmrc ./

# Install dependencies at build time with correct Linux binaries
RUN pnpm install --frozen-lockfile

EXPOSE 3000

# Start Nuxt dev server bound to all interfaces so Docker port-forwarding works
CMD ["pnpm", "run", "dev", "--", "--host"]