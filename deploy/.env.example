# Copy to .env next to docker-compose.yml on the server. Docker Compose reads it
# to fill in docker-compose.yml.

# Version to run: main (latest build of main), a version or sha-<commit>.
# The deploy job of the GitLab CI sets it to the commit it deploys.
MB_TAG=main

# Database password, set once
POSTGRES_PASSWORD=

# Where the browser reaches the UI and the API. The GitLab application's
# redirect URI is <PUBLIC_API_URL>/auth/gitlab/callback.
FRONTEND_URL=
PUBLIC_API_URL=
