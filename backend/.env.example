# MAESTRO-bench configuration: copy this file to backend/.env and fill in the
# "Required" part. Everything else has a working default (see the README,
# "Configuration", for what each setting does).
#
# Generate a secret:  openssl rand -base64 48

# ---------------------------------------------------------------------------
# Required: sign-in
# ---------------------------------------------------------------------------
# The backend refuses to start without these.
# Signs the OAuth state and derives the CSRF tokens (32+ characters)
SECRET_KEY=
# GitLab application: Edit profile > Applications, Confidential, scopes
# openid profile email, redirect URI http://localhost:8000/auth/gitlab/callback
AUTH_GITLAB_BASE_URL=https://gitlab.irit.fr
AUTH_GITLAB_CLIENT_ID=
AUTH_GITLAB_CLIENT_SECRET=
# Who may sign in: email domains and/or GitLab groups (or AUTH_ALLOW_ANY_USER=true)
AUTH_ALLOWED_EMAIL_DOMAINS=irit.fr
# AUTH_GITLAB_ALLOWED_GROUPS=org/team

# ---------------------------------------------------------------------------
# Strongly advised
# ---------------------------------------------------------------------------
# Administrators. The first one to sign in owns the "default" workspace, where
# `scripts/seed.py` puts the sample data: without it, nobody can open it.
INSTANCE_ADMINS=you@irit.fr

# ---------------------------------------------------------------------------
# LLM providers: at least one key, or an Ollama URL
# ---------------------------------------------------------------------------
# Without any, add keys later from a workspace's Settings (needs ENCRYPTION_KEY below).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
# Also recognised: GROQ_API_KEY, TOGETHER_API_KEY, DEEPSEEK_API_KEY, GEMINI_API_KEY,
# XAI_API_KEY, CEREBRAS_API_KEY, PERPLEXITYAI_API_KEY, OPENROUTER_API_KEY

# Ollama needs no key: set the URL of your server to enable it. Pull a model
# first (`ollama pull llama3.2`), then register it under the "ollama" provider.
# In Docker, localhost is the container: use http://host.docker.internal:11434
# OLLAMA_API_BASE=http://localhost:11434

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Lets workspace owners store their own provider keys (32+ random characters,
# apart from SECRET_KEY). Changing it makes the stored keys unreadable.
# ENCRYPTION_KEY=
# false: every workspace must bring its own keys instead of using the ones above
# PROVIDERS_INSTANCE_FALLBACK=true

# Requests per second cap per provider, shared by all running experiments
# MISTRAL_MAX_RPS=1
# A local Ollama saturates quickly under parallel rows: 1 is a safe start
# OLLAMA_MAX_RPS=1

# Who may create workspaces: any signed-in user, or only the INSTANCE_ADMINS
# WORKSPACE_CREATION=any
# Experiments running at once, per workspace and for the whole instance
# MAX_CONCURRENT_EXPERIMENTS_PER_WORKSPACE=3
# MAX_CONCURRENT_EXPERIMENTS=8
# Largest dataset file accepted by an upload
# MAX_UPLOAD_MB=50
# Make public read-only links impossible
# PUBLIC_SHARING_ENABLED=true

# Behind another host or port than http://localhost:3000 (UI) and
# http://localhost:8000 (API); the GitLab redirect URI follows PUBLIC_API_URL
# FRONTEND_URL=http://localhost:3000
# PUBLIC_API_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:3000
