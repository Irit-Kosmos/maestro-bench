# MAESTRO-bench backend configuration
# Copy this file to .env and fill in your values

# ---------------------------------------------------------------------------
# LLM Provider API Keys (at least one required)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
# Also recognised: GROQ_API_KEY, TOGETHER_API_KEY, DEEPSEEK_API_KEY, GEMINI_API_KEY,
# XAI_API_KEY, CEREBRAS_API_KEY, PERPLEXITYAI_API_KEY, OPENROUTER_API_KEY

# Ollama needs no key: set the URL of your server to enable it. Pull a model
# first (`ollama pull llama3.2`), then register it under the "ollama" provider.
# In Docker, localhost is the container: use http://host.docker.internal:11434
# OLLAMA_API_BASE=http://localhost:11434

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Transient errors (429, timeouts, 5xx) are retried with exponential backoff,
# honoring the provider's Retry-After header.
LLM_MAX_RETRIES=6
# Optional cap on requests per second, per provider: <PROVIDER>_MAX_RPS.
# Shared by all running experiments. Match it to your plan's quota.
# MISTRAL_MAX_RPS=1
# A local Ollama saturates quickly under parallel rows: OLLAMA_MAX_RPS=1 is a safe start.

# ---------------------------------------------------------------------------
# API Server
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL only. Docker Compose overrides this with its own postgres service.
DATABASE_URL=postgresql+psycopg://maestro:maestro@localhost:5432/maestro
DB_ECHO=false

# ---------------------------------------------------------------------------
# Files on disk, one folder per workspace: <DATA_DIR>/workspaces/<id>/{datasets,results}
# Defaults to the repository root outside Docker (Compose sets /data).
# ---------------------------------------------------------------------------
# DATA_DIR=/path/to/data
# Largest dataset file accepted by an upload
# MAX_UPLOAD_MB=50

# ---------------------------------------------------------------------------
# Concurrent experiments: the ones over the limits wait in a queue
# ---------------------------------------------------------------------------
# MAX_CONCURRENT_EXPERIMENTS_PER_WORKSPACE=3
# MAX_CONCURRENT_EXPERIMENTS=8

# ---------------------------------------------------------------------------
# API keys stored by workspaces
# ---------------------------------------------------------------------------
# Encrypts them (32+ random characters, apart from SECRET_KEY):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it workspaces cannot store keys. Changing it makes the stored keys unreadable.
# ENCRYPTION_KEY=
# Let a workspace without its own key for a provider use the instance's (the variables
# above). false: every workspace must bring its own keys. Ollama is unaffected.
# PROVIDERS_INSTANCE_FALLBACK=true
# How long an invitation link can be used
# INVITATION_DAYS=7

# ---------------------------------------------------------------------------
# Authentication: GitLab sign-in (OpenID Connect)
# ---------------------------------------------------------------------------
# Signs the OAuth state and derives the CSRF tokens (32+ characters):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# GitLab application: Edit profile > Applications, Confidential, scopes
# openid profile email, redirect URI <PUBLIC_API_URL>/auth/gitlab/callback
AUTH_GITLAB_BASE_URL=https://gitlab.example.org
AUTH_GITLAB_CLIENT_ID=
AUTH_GITLAB_CLIENT_SECRET=
# Who may sign in. Every restriction that is set must be satisfied, and the
# backend refuses to start with none (unless AUTH_ALLOW_ANY_USER=true).
AUTH_ALLOWED_EMAIL_DOMAINS=example.org
# AUTH_GITLAB_ALLOWED_GROUPS=org/team
# AUTH_ALLOW_ANY_USER=false
INSTANCE_ADMINS=you@example.org
# Who may create workspaces: any signed-in user, or only the INSTANCE_ADMINS
# WORKSPACE_CREATION=any
# Where the browser reaches the UI and the API (defaults shown)
# FRONTEND_URL=http://localhost:3000
# PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# CORS (comma-separated origins)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
