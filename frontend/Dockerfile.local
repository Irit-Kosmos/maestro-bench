# Use Node.js 22 for development
FROM node:22 AS develop

# Set the working directory inside the container
WORKDIR /app

# Install global dependencies (optional, if you need specific CLI tools)
RUN npm install -g nuxi

# Expose the default development server port
EXPOSE 3000

# Command to install dependencies and start the development server
CMD ["sh", "-c", "npm install && npm run dev"]