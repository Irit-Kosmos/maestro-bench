# MAESTRO-bench backend configuration
# Copy this file to .env and fill in your values

# ---------------------------------------------------------------------------
# LLM Provider API Keys (at least one required)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
# Also recognised: GROQ_API_KEY, TOGETHER_API_KEY, DEEPSEEK_API_KEY, GEMINI_API_KEY,
# XAI_API_KEY, CEREBRAS_API_KEY, PERPLEXITYAI_API_KEY, OPENROUTER_API_KEY

# Ollama needs no key: set the URL of your server to enable it. Pull a model
# first (`ollama pull llama3.2`), then register it under the "ollama" provider.
# In Docker, localhost is the container: use http://host.docker.internal:11434
# OLLAMA_API_BASE=http://localhost:11434

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Transient errors (429, timeouts, 5xx) are retried with exponential backoff,
# honoring the provider's Retry-After header.
LLM_MAX_RETRIES=6
# Optional cap on requests per second, per provider: <PROVIDER>_MAX_RPS.
# Shared by all running experiments. Match it to your plan's quota.
# MISTRAL_MAX_RPS=1
# A local Ollama saturates quickly under parallel rows: OLLAMA_MAX_RPS=1 is a safe start.

# ---------------------------------------------------------------------------
# API Server
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL only. Docker Compose overrides this with its own postgres service.
DATABASE_URL=postgresql+psycopg://maestro:maestro@localhost:5432/maestro
DB_ECHO=false

# ---------------------------------------------------------------------------
# Files on disk: datasets in <DATA_DIR>/datasets, results in <DATA_DIR>/results
# Defaults to the repository root outside Docker (Compose sets /data).
# ---------------------------------------------------------------------------
# DATA_DIR=/path/to/data

# ---------------------------------------------------------------------------
# CORS (comma-separated origins)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
